    \u043B\u044E\u0431\u044B\u043C \u0447\u0435\u0440\u0442\u044F\u043C \u0441 \u043C\u0430\u0442\u0435\u0440\u044F\u043C\u0438
    \u043A\u0430\u0442\u0438\u0441\u044C \u043B\u044E\u0431\u0430\u044F \u0431\u0443\u043C\u0430\u0436\u043A\u0430.\u041D\u043E
    \u044D\u0442\u0443\u2026\u041F\u043E \u0434\u043B\u0438\u043D\u043D\u043E\u043C\u0443
    \u0444\u0440\u043E\u043D\u0442\u0443 \u043A\u0443\u043F\u0435 \u0438 \u043A\u0430\u044E\u0442
    \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0443\u0447\u0442\u0438\u0432\u044B\u0439
    \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F.\u0421\u0434\u0430\u044E\u0442
    \u043F\u0430\u0441\u043F\u043E\u0440\u0442\u0430, \u0438 \u044F \u0441\u0434\u0430\u044E
    \u043C\u043E\u044E \u043F\u0443\u0440\u043F\u0443\u0440\u043D\u0443\u044E \u043A\u043D\u0438\u0436\u0438\u0446\u0443.\u041A
    \u043E\u0434\u043D\u0438\u043C \u043F\u0430\u0441\u043F\u043E\u0440\u0442\u0430\u043C
    \u2014 \u0443\u043B\u044B\u0431\u043A\u0430 \u0443 \u0440\u0442\u0430.\u041A
    \u0434\u0440\u0443\u0433\u0438\u043C \u2014 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435
    \u043F\u043B\u0435\u0432\u043E\u0435.\u0421 \u043F\u043E\u0447\u0442\u0435\u043D\u044C\u0435\u043C
    \u0431\u0435\u0440\u0443\u0442, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043F\u0430\u0441\u043F\u043E\u0440\u0442\u0430 \u0441 \u0434\u0432\u0443\u0445\u0441\u043F\u0430\u043B\u044C\u043D\u044B\u043C
    \u0430\u043D\u0433\u043B\u0438\u0439\u0441\u043A\u0438\u043C \u043B\u0435\u0432\u043E\u044E.\u0413\u043B\u0430\u0437\u0430\u043C\u0438
    \u0434\u043E\u0431\u0440\u043E\u0433\u043E \u0434\u044F\u0434\u044E \u0432\u044B\u0435\u0432,
    \u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u0430\u044F \u043A\u043B\u0430\u043D\u044F\u0442\u044C\u0441\u044F,\u0431\u0435\u0440\u0443\u0442,
    \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0431\u0435\u0440\u0443\u0442
    \u0447\u0430\u0435\u0432\u044B\u0435, \u043F\u0430\u0441\u043F\u043E\u0440\u0442
    \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0446\u0430.\u041D\u0430 \u043F\u043E\u043B\u044C\u0441\u043A\u0438\u0439
    \u2014 \u0433\u043B\u044F\u0434\u044F\u0442, \u043A\u0430\u043A \u0432 \u0430\u0444\u0438\u0448\u0443
    \u043A\u043E\u0437\u0430.\u041D\u0430 \u043F\u043E\u043B\u044C\u0441\u043A\u0438\u0439
    \u2014 \u0432\u044B\u043F\u044F\u043B\u0438\u0432\u0430\u044E\u0442 \u0433\u043B\u0430\u0437\u0430
    \u0432 \u0442\u0443\u0433\u043E\u0439 \u043F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u043E\u0439
    \u0441\u043B\u043E\u043D\u043E\u0432\u043E\u0441\u0442\u0438\r\n"
